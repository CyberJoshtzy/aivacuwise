[Unit]
Description=Ai-Vacuwise cloud sync agent
After=network-online.target bilislikas.service
Wants=network-online.target

[Service]
User=ian
WorkingDirectory=/home/ian/ai-vacuwise
ExecStart=/home/ian/ai-vacuwise/venv/bin/python sync_agent.py server-a
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
